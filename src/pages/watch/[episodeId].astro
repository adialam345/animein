---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { animeApi } from '../../services/anime';

const { episodeId } = Astro.params;
const videoData = await animeApi.getVideo(episodeId as string);

if (!videoData || !videoData.video || videoData.video.length === 0) {
    return Astro.redirect('/404');
}

// Prioritize cleaner video sources (blogger, mega first, then others)
const priorityOrder = ['blogger.com', 'mega.nz', 'b-cdn.net', 'drive.google'];
const sortedVideos = [...videoData.video].sort((a, b) => {
    const aPriority = priorityOrder.findIndex(p => a.link?.includes(p));
    const bPriority = priorityOrder.findIndex(p => b.link?.includes(p));
    const aScore = aPriority === -1 ? 999 : aPriority;
    const bScore = bPriority === -1 ? 999 : bPriority;
    return aScore - bScore;
});

// Default to first prioritized (cleanest) source
const defaultVideo = sortedVideos[0] || videoData.video[0];
---

<Layout title={`Watching ${videoData.episode_id} | ANIMEIN`}>
  <main class="min-h-screen pt-20 pb-12">
    {/* Ambient Background Gradient */}
    <div class="fixed inset-0 bg-[radial-gradient(circle_at_top,_rgba(142,68,173,0.1)_0%,_transparent_50%)] pointer-events-none -z-10"></div>

    <div class="container mx-auto px-4 md:px-8">
      {/* breadcrumbs-like navigation */}
      <nav class="flex items-center gap-4 mb-8">
        <a 
          href="javascript:history.back()" 
          class="group flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 hover:bg-white/10 border border-white/5 backdrop-blur-md transition-all duration-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-500 group-hover:text-white transition-colors">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          <span class="text-sm font-bold text-zinc-400 group-hover:text-white transition-colors">Back</span>
        </a>
      </nav>

      <div class="max-w-6xl mx-auto space-y-8">
        {/* Player Section */}
        <div class="space-y-6 animate-fade-in-up">
          <div class="relative group" id="player-wrapper">
            <div class="relative rounded-3xl overflow-hidden shadow-[0_30px_60px_rgba(0,0,0,0.6)] bg-black border border-white/5 aspect-video">
              {/* Anti-redirect overlay - click to activate player */}
              <div id="player-overlay" class="absolute inset-0 z-20 bg-black/60 backdrop-blur-sm flex items-center justify-center cursor-pointer transition-all duration-300 hover:bg-black/40">
                <div class="text-center space-y-4">
                  <div class="w-20 h-20 mx-auto rounded-full bg-[#8e44ad]/30 flex items-center justify-center border-2 border-[#8e44ad] animate-pulse">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="white" class="ml-1">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                  </div>
                  <div class="space-y-2">
                    <p class="text-white font-bold text-lg">Klik untuk Putar Video</p>
                    <p class="text-zinc-400 text-sm max-w-xs">Proteksi anti-redirect aktif. Klik sekali untuk mengaktifkan player.</p>
                  </div>
                </div>
              </div>
              <iframe 
                src={defaultVideo.link} 
                allowfullscreen 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
                referrerpolicy="no-referrer"
                class="w-full h-full border-none"
                id="main-player"
              ></iframe>
            </div>
          </div>

          {/* Episode Info & Quality Selector */}
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="md:col-span-2 bg-white/5 backdrop-blur-md rounded-3xl p-6 md:p-8 border border-white/5 space-y-4">
              <div class="flex items-center justify-between gap-4">
                <div class="space-y-1">
                  <span class="text-[#a569bd] font-black text-xs uppercase tracking-[0.2em]">Now Playing</span>
                  <h1 
                    class="text-2xl md:text-3xl font-black text-white tracking-tight"
                    data-anime-title={videoData.episode_id.split('-').slice(0, -1).join(' ')}
                    data-anime-source="otakudesu"
                    data-episode-number={videoData.episode_id.split('-').pop()}
                  >
                    Episode {videoData.episode_id.split('-').pop()}
                  </h1>
                </div>
                <button 
                  id="reportErrorBtn"
                  class="group flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-orange-600/20 hover:bg-orange-600/40 border border-orange-500/30 transition-all duration-300"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-400 group-hover:text-orange-200">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                  </svg>
                  <span class="text-[10px] font-black text-orange-300 group-hover:text-orange-100 uppercase tracking-widest">Error?</span>
                </button>
              </div>
              <p class="text-zinc-500 font-medium text-sm leading-relaxed">
                ID: {videoData.episode_id}. Jika video tidak berputar, silakan coba ganti resolusi atau gunakan browser Chrome.
              </p>
            </div>

            <div class="bg-white/5 backdrop-blur-md rounded-3xl p-6 md:p-8 border border-white/10 flex flex-col justify-center gap-4">
              <h3 class="text-white font-black text-xs uppercase tracking-widest text-center">Select Quality</h3>
              <div class="flex flex-wrap items-center justify-center gap-2">
                {videoData.video.map((v, index) => (
                  <button 
                    class={`server-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 border ${
                      index === videoData.video.length - 1 
                        ? 'bg-[#8e44ad] border-[#8e44ad] text-white shadow-[0_0_15px_rgba(142,68,173,0.4)]' 
                        : 'bg-white/5 border-white/5 text-zinc-500 hover:border-white/20 hover:text-white'
                    }`}
                    data-link={v.link}
                  >
                    {v.reso}
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>

        {/* Support/Notice */}
        <div class="bg-gradient-to-r from-[#8e44ad]/10 to-transparent p-6 rounded-3xl border border-[#8e44ad]/20 flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-[#8e44ad]/20 flex items-center justify-center text-[#a569bd] shrink-0">
             <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <div class="text-zinc-400 text-sm font-medium space-y-1">
            <p><strong class="text-white">Tips:</strong> Jika masih ada redirect, tutup tab iklan lalu kembali ke sini dan klik lagi. Atau coba ganti server/kualitas lain.</p>
            <p class="text-xs text-zinc-500">Gunakan browser dengan adblocker (uBlock Origin) untuk pengalaman terbaik.</p>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  function initErrorReport() {
    const reportBtn = document.getElementById('reportErrorBtn');
    if (reportBtn) {
      reportBtn.addEventListener('click', async () => {
        reportBtn.setAttribute('disabled', 'true');
        reportBtn.classList.add('opacity-50', 'cursor-not-allowed');
        await fetch('/api/admin/error-reports', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url: window.location.href })
        });
        alert('Laporan terkirim! Gunakan Chrome jika masih error.');
        window.location.reload();
      });
    }
  }

  function initPlayer() {
    const buttons = document.querySelectorAll('.server-btn');
    const player = document.getElementById('main-player') as HTMLIFrameElement;
    const overlay = document.getElementById('player-overlay');
    
    initErrorReport();

    // Handle overlay click - activate player
    if (overlay) {
      overlay.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        overlay.style.opacity = '0';
        overlay.style.pointerEvents = 'none';
        setTimeout(() => {
          overlay.style.display = 'none';
        }, 300);
      });
    }

    // Handle server button clicks
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const link = btn.getAttribute('data-link');
        if (link && player) {
          player.src = link;
          
          // Re-show overlay for new server (protection)
          if (overlay) {
            overlay.style.display = 'flex';
            overlay.style.opacity = '1';
            overlay.style.pointerEvents = 'auto';
          }
          
          // Update active state
          buttons.forEach(b => {
            b.classList.remove('bg-[#8e44ad]', 'border-[#8e44ad]', 'text-white', 'shadow-[0_0_15px_rgba(142,68,173,0.4)]');
            b.classList.add('bg-white/5', 'border-white/5', 'text-zinc-500');
          });
          btn.classList.add('bg-[#8e44ad]', 'border-[#8e44ad]', 'text-white', 'shadow-[0_0_15px_rgba(142,68,173,0.4)]');
          btn.classList.remove('bg-white/5', 'border-white/5', 'text-zinc-500');
        }
      });
    });
  }

  // Run on page load and View Transitions
  initPlayer();
  document.addEventListener('astro:page-load', initPlayer);
</script>

<style>
  .container {
    max-width: 1200px;
  }
</style>
