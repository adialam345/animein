---
import Layout from '../layouts/Layout.astro';
import AnimeCard from '../components/AnimeCard.astro';
import { animeApi } from '../services/anime';

const movieAnime = await animeApi.getMovies();

const normalizeAnime = (anime: any) => ({
  id: anime.url,
  title: anime.judul,
  coverImage: anime.cover,
  rating: 'Movie',
  type: 'Film',
  status: anime.lastup || 'Finished'
});
---

<Layout title="Anime Movies - AnimeIn">
  <main class="min-h-screen pt-24 pb-20">
    <div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
      <div class="absolute top-[10%] left-[5%] w-[400px] h-[400px] bg-[#8e44ad]/5 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-[20%] right-[5%] w-[300px] h-[300px] bg-[#a569bd]/5 rounded-full blur-[100px]"></div>
    </div>

    <div class="container mx-auto px-4 md:px-8 relative z-10">
      <div class="mb-12 space-y-4">
        <div class="flex items-center gap-3">
          <div class="h-10 w-1.5 bg-[#8e44ad] rounded-full shadow-[0_0_15px_rgba(142,68,173,0.5)]"></div>
          <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight">Anime Movies</h1>
        </div>
        <p class="text-zinc-500 font-medium text-lg ml-4">Nikmati koleksi film anime layar lebar dengan kualitas terbaik.</p>
      </div>

      {!movieAnime || movieAnime.length === 0 ? (
        <div class="flex flex-col items-center justify-center py-24 text-center space-y-6 animate-fade-in-up">
          <div class="w-32 h-32 rounded-full bg-white/5 flex items-center justify-center text-zinc-700">
             <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="m15 10-4 2 4 2Z"/></svg>
          </div>
          <div class="space-y-2">
            <h2 class="text-2xl font-bold text-white uppercase tracking-widest">Kosong</h2>
            <p class="text-zinc-500 max-w-xs mx-auto font-medium">Belum ada film anime yang tersedia saat ini. Silakan cek kembali nanti!</p>
          </div>
        </div>
      ) : (
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-6">
          {movieAnime.map(anime => (
            <AnimeCard {...normalizeAnime(anime)} />
          ))}
        </div>
      )}
    </div>
  </main>
</Layout>

<style>
  .container {
    max-width: 1200px;
  }
</style>
