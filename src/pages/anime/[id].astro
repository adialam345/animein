---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { animeApi } from '../../services/anime';

const { id } = Astro.params;
const anime = await animeApi.getDetail(id as string);

if (!anime) {
    return Astro.redirect('/404');
}

const firstEpisodeId = anime.episodes && anime.episodes.length > 0 ? anime.episodes[0].url : null;
---

<Layout title={`${anime.judul} | ANIMEIN`} description={anime.sinopsis}>
  <main class="relative min-h-screen pt-20">
    {/* Page Backdrop */}
    <div class="absolute top-0 left-0 w-full h-[60vh] z-0 overflow-hidden">
      <div 
        class="absolute inset-0 bg-cover bg-center blur-[80px] opacity-20 scale-110"
        style={`background-image: url(${anime.cover})`}
      ></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0c] via-[#0a0a0c]/80 to-transparent"></div>
    </div>

    <div class="container mx-auto px-4 md:px-8 relative z-10 py-8">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 md:gap-12">
        
        {/* Sidebar: Cover Art & CTA */}
        <div class="lg:col-span-1">
          <div class="sticky top-24 space-y-6">
            <div class="rounded-3xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/10 group">
              <img
                src={anime.cover}
                alt={anime.judul}
                class="w-full aspect-[2/3] object-cover transition-transform duration-700 group-hover:scale-110"
                fetchpriority="high"
                loading="eager"
              />
            </div>

            {firstEpisodeId && (
              <a
                href={`/watch/${firstEpisodeId}`}
                class="w-full flex items-center justify-center gap-3 bg-[#8e44ad] hover:bg-[#a569bd] text-white font-black py-4 rounded-2xl transition-all duration-300 shadow-[0_8px_25px_rgba(142,68,173,0.4)] hover:-translate-y-1"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                MULAI NONTON
              </a>
            )}

            <div class="grid grid-cols-2 gap-4">
              <div class="bg-white/5 border border-white/10 p-4 rounded-2xl text-center">
                <span class="block text-zinc-500 text-[10px] font-black uppercase tracking-widest mb-1">Score</span>
                <span class="text-xl font-black text-yellow-500">★ {anime.score}</span>
              </div>
              <div class="bg-white/5 border border-white/10 p-4 rounded-2xl text-center">
                <span class="block text-zinc-500 text-[10px] font-black uppercase tracking-widest mb-1">Status</span>
                <span class="text-sm font-black text-white uppercase">{anime.status}</span>
              </div>
            </div>
          </div>
        </div>

        {/* Main Content: Info & Episodes */}
        <div class="lg:col-span-3 space-y-10">
          <div class="space-y-6">
            <div class="space-y-2">
              <div class="flex items-center gap-3 text-[#a569bd] font-bold text-sm uppercase tracking-widest">
                <span>{anime.rilis}</span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#8e44ad]"></span>
                <span>{anime.studio}</span>
              </div>
              <h1 class="text-4xl md:text-6xl font-black text-white tracking-tight leading-tight">
                {anime.judul}
              </h1>
            </div>

            {/* Genres */}
            <div class="flex flex-wrap gap-2">
              {anime.genre?.map(g => (
                <span class="px-5 py-2.5 bg-white/5 hover:bg-white/10 border border-white/5 rounded-xl text-zinc-300 text-sm font-bold transition-all duration-300 cursor-default">
                  {g}
                </span>
              ))}
            </div>

            {/* Synopsis */}
            <div class="space-y-4">
              <div class="flex items-center gap-2">
                <div class="h-6 w-1 bg-[#8e44ad] rounded-full"></div>
                <h2 class="text-xl font-black text-white uppercase tracking-wider">Sinopsis</h2>
              </div>
              <p class="text-zinc-400 leading-relaxed text-lg font-medium">
                {anime.sinopsis}
              </p>
            </div>
          </div>

          {/* Episode List */}
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="h-6 w-1 bg-[#8e44ad] rounded-full"></div>
                <h2 class="text-xl font-black text-white uppercase tracking-wider">Episode List</h2>
              </div>
              <span class="text-zinc-500 font-bold text-sm uppercase tracking-widest">
                {anime.episodes?.length || 0} Episodes
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {anime.episodes?.map(ep => (
                <a 
                  href={`/watch/${ep.url}`} 
                  class="group flex items-center justify-between p-5 bg-white/5 hover:bg-[#8e44ad]/10 border border-white/5 hover:border-[#8e44ad]/30 rounded-2xl transition-all duration-300"
                >
                  <div class="space-y-1">
                    <span class="block text-white font-black group-hover:text-[#a569bd] transition-colors">Episode {ep.ch}</span>
                    <span class="block text-zinc-500 text-xs font-bold uppercase tracking-wider">{ep.date}</span>
                  </div>
                  <div class="w-10 h-10 rounded-full bg-[#8e44ad]/10 flex items-center justify-center text-[#a569bd] group-hover:bg-[#8e44ad] group-hover:text-white transition-all duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .container {
    max-width: 1200px;
  }
</style>
