---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { animeApi } from '../../services/anime';

const { id } = Astro.params;
const anime = await animeApi.getDetail(id as string);

if (!anime) {
    return Astro.redirect('/404');
}

const episodes = anime.episodes ? [...anime.episodes].reverse() : [];
const firstEpisodeId = episodes.length > 0 ? episodes[0].url : null;

// Schema SEO
const animeSchema = {
  "@context": "https://schema.org",
  "@type": "Movie",
  "name": anime.judul,
  "description": anime.sinopsis,
  "image": anime.cover,
  "genre": anime.genre || [],
  "numberOfEpisodes": anime.episodes?.length || 0,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": Astro.url.origin
  },{
    "@type": "ListItem",
    "position": 2,
    "name": anime.judul,
    "item": Astro.url.href
  }]
};
---

<Layout title={`${anime.judul} Sub Indo Gratis - ANIMEIN`} description={anime.sinopsis}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(animeSchema)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  
  <main class="relative min-h-screen pt-20">
    {/* Page Backdrop */}
    <div class="absolute top-0 left-0 w-full h-[60vh] z-0 overflow-hidden">
      <div 
        class="absolute inset-0 bg-cover bg-center blur-[80px] opacity-10 scale-110"
        style={`background-image: url(${anime.cover})`}
      ></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0c] via-[#0a0a0c]/80 to-transparent"></div>
    </div>

    <div class="container mx-auto px-4 py-6 md:py-12 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 md:gap-12">
        
        {/* Mobile: Compact horizontal layout */}
        <div class="lg:hidden mb-4">
          <div class="flex gap-5">
            {/* Smaller cover on mobile */}
            <div class="flex-shrink-0 w-32 sm:w-44">
              <div class="rounded-2xl overflow-hidden shadow-2xl border border-white/10">
                <img
                  src={anime.cover}
                  alt={anime.judul}
                  class="w-full aspect-[2/3] object-cover"
                  fetchpriority="high"
                  loading="eager"
                />
              </div>
            </div>
            
            {/* Title and CTA on the right */}
            <div class="flex-1 flex flex-col justify-between py-1">
              <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <span class="px-2 py-0.5 bg-[#8e44ad]/20 text-[#a569bd] rounded-md text-[10px] font-bold uppercase tracking-wider">
                    {anime.type || 'TV'}
                  </span>
                  <span class="px-2 py-0.5 bg-zinc-800 text-zinc-400 rounded-md text-[10px] font-bold uppercase tracking-wider">
                    {anime.status}
                  </span>
                </div>
                <h1 class="text-xl sm:text-2xl font-black text-white leading-tight line-clamp-3">
                  {anime.judul}
                </h1>
                <div class="flex items-center gap-2 text-yellow-500 font-bold text-sm">
                  <span>★ {anime.score}</span>
                </div>
              </div>
              
              {firstEpisodeId && (
                <a
                  href={`/watch/${anime.id}/${firstEpisodeId}`}
                  class="flex items-center justify-center gap-2 bg-[#8e44ad] hover:bg-[#a569bd] text-white font-bold px-4 py-3 rounded-xl transition-all duration-300 text-sm shadow-lg shadow-[#8e44ad]/20 active:scale-95"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  Mulai Menonton
                </a>
              )}
            </div>
          </div>
        </div>
        
        {/* Desktop: Sidebar layout */}
        <div class="hidden lg:block lg:col-span-1">
          <div class="sticky top-24 space-y-6">
            <div class="rounded-3xl overflow-hidden shadow-2xl border border-white/10 group">
              <img
                src={anime.cover}
                alt={anime.judul}
                class="w-full aspect-[2/3] object-cover transition-transform duration-700 group-hover:scale-105"
                fetchpriority="high"
                loading="eager"
              />
            </div>

            {firstEpisodeId && (
              <a
                href={`/watch/${anime.id}/${firstEpisodeId}`}
                class="w-full flex items-center justify-center gap-3 bg-[#8e44ad] hover:bg-[#a569bd] text-white font-black py-4 rounded-2xl transition-all duration-300 shadow-xl shadow-[#8e44ad]/20 hover:-translate-y-1 active:scale-95"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                MULAI MENONTON
              </a>
            )}

            <div class="grid grid-cols-2 gap-4">
              <div class="bg-white/5 border border-white/5 p-4 rounded-2xl text-center backdrop-blur-sm">
                <span class="block text-zinc-500 text-[10px] font-black uppercase tracking-widest mb-1">Score</span>
                <span class="text-xl font-black text-yellow-500">★ {anime.score}</span>
              </div>
              <div class="bg-white/5 border border-white/5 p-4 rounded-2xl text-center backdrop-blur-sm">
                <span class="block text-zinc-500 text-[10px] font-black uppercase tracking-widest mb-1">Status</span>
                <span class="text-sm font-black text-white uppercase">{anime.status}</span>
              </div>
            </div>
          </div>
        </div>

        {/* Main Content */}
        <div class="lg:col-span-3 space-y-10">
          <div class="space-y-6">
            <div class="hidden lg:block space-y-3">
              <div class="flex items-center gap-3 text-[#a569bd] font-bold text-xs uppercase tracking-widest">
                <span>{anime.rilis}</span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#8e44ad]"></span>
                <span>{anime.studio}</span>
              </div>
              <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
                {anime.judul}
              </h1>
            </div>

            {/* Genres */}
            {anime.genre && anime.genre.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {anime.genre.map(g => (
                  <span class="px-5 py-2.5 bg-zinc-900/50 hover:bg-[#8e44ad]/10 border border-white/5 rounded-xl text-zinc-300 text-sm font-bold transition-all duration-300 cursor-default">
                    {g}
                  </span>
                ))}
              </div>
            )}

            {/* Synopsis */}
            {anime.sinopsis && (
              <div class="space-y-4">
                <h2 class="text-xl font-black text-white uppercase tracking-wider flex items-center gap-2">
                   <span class="w-1 h-6 bg-[#8e44ad] rounded-full"></span>
                   Sinopsis
                </h2>
                <p class="text-zinc-400 leading-relaxed text-base md:text-lg font-medium">
                  {anime.sinopsis}
                </p>
              </div>
            )}
          </div>

          {/* Episode List */}
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <h2 class="text-xl font-black text-white uppercase tracking-wider flex items-center gap-2">
                <span class="w-1 h-6 bg-[#8e44ad] rounded-full"></span>
                Episode List
              </h2>
              <span class="text-zinc-500 font-bold text-sm uppercase tracking-widest bg-white/5 px-4 py-2 rounded-xl">
              {episodes.length} Episodes
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {episodes.map(ep => (
                <a 
                  href={`/watch/${anime.id}/${ep.url}`} 
                  class="group flex items-center justify-between p-5 bg-zinc-900/40 hover:bg-[#8e44ad]/10 border border-white/5 hover:border-[#8e44ad]/30 rounded-2xl transition-all duration-300 backdrop-blur-sm"
                >
                  <div class="space-y-1">
                    <span class="block text-white font-black group-hover:text-[#a569bd] transition-colors">Episode {ep.ch}</span>
                    <span class="block text-zinc-500 text-[10px] font-bold uppercase tracking-wider">{ep.date}</span>
                  </div>
                  <div class="w-10 h-10 rounded-full bg-[#8e44ad]/10 flex items-center justify-center text-[#a569bd] group-hover:bg-[#8e44ad] group-hover:text-white transition-all duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .container {
    max-width: 1200px;
  }
</style>

