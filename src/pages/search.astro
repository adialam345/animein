---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import AnimeCard from '../components/AnimeCard.astro';
import { animeApi } from '../services/anime';

const query = Astro.url.searchParams.get('q') || '';
let searchResults: any[] = [];
let loading = false;

if (query) {
  loading = true;
  searchResults = await animeApi.search(query);
  loading = false;
}

const normalizeAnime = (anime: any) => ({
  id: anime.url,
  title: anime.judul,
  coverImage: anime.cover,
  rating: anime.score || 'N/A',
  type: anime.rilis || 'Series',
  status: anime.total_episode ? `${anime.total_episode} Eps` : 'Ongoing'
});
---

<Layout title={`Hasil Pencarian: ${query} - AnimeIn`}>
  <main class="min-h-screen pt-24 pb-20">
    <div class="container mx-auto px-4 md:px-8">
      <div class="mb-12 space-y-4">
        <div class="flex items-center gap-3">
          <div class="h-10 w-1.5 bg-[#8e44ad] rounded-full shadow-[0_0_15px_rgba(142,68,173,0.5)]"></div>
          <h1 class="text-3xl md:text-5xl font-black text-white tracking-tight">
            Hasil Pencarian: <span class="text-[#a569bd]">{query}</span>
          </h1>
        </div>
        <p class="text-zinc-500 font-medium ml-4">Menampilkan hasil untuk kata kunci "{query}"</p>
      </div>

      {searchResults.length === 0 ? (
        <div class="flex flex-col items-center justify-center py-20 text-center space-y-6 animate-fade-in-up">
          <div class="w-32 h-32 rounded-full bg-white/5 flex items-center justify-center text-zinc-700">
             <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          </div>
          <div class="space-y-2">
            <h2 class="text-xl font-bold text-white uppercase tracking-widest">Tidak Ditemukan</h2>
            <p class="text-zinc-500 max-w-xs mx-auto">Maaf, kami tidak dapat menemukan anime dengan judul tersebut. Coba gunakan kata kunci lain.</p>
          </div>
          <button data-open-search class="px-8 py-3 bg-[#8e44ad] hover:bg-[#a569bd] text-white rounded-2xl font-bold transition-all duration-300">
            Cari Lagi
          </button>
        </div>
      ) : (
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-6">
          {searchResults.map(anime => (
            <AnimeCard {...normalizeAnime(anime)} />
          ))}
        </div>
      )}
    </div>
  </main>
</Layout>

<style>
  .container {
    max-width: 1200px;
  }
</style>
