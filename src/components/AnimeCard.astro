---
interface Props {
  id: string;
  title: string;
  coverImage: string;
  rating?: string;
  type?: string;
  status?: string;
}

const { id, title, coverImage, rating, type, status } = Astro.props;
---

<a href={`/anime/${id}`} class="group block relative" data-astro-prefetch>
  <div class="relative overflow-hidden rounded-2xl bg-zinc-900/50 aspect-[2/3] transition-all duration-500 ease-out group-hover:shadow-[0_8px_30px_rgb(0,0,0,0.5)]">
    <img
      src={coverImage}
      alt={title}
      loading="lazy"
      class="w-full h-full object-cover transition-all duration-700 ease-in-out group-hover:scale-110 opacity-0"
      onload="this.classList.remove('opacity-0')"
    />

    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-500"></div>

    {/* Info Badges */}
    <div class="absolute top-2 left-2 flex flex-col gap-1">
      {rating && (
        <div class="px-2 py-0.5 rounded text-[10px] font-bold text-white uppercase backdrop-blur-md bg-yellow-500/80 flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          {rating}
        </div>
      )}
      {status && (
        <div class="px-2 py-0.5 rounded text-[10px] font-bold text-white uppercase backdrop-blur-md bg-[#8e44ad]/80">
          {status}
        </div>
      )}
    </div>

    {type && (
      <div class="absolute top-2 right-2 px-2 py-0.5 rounded text-[10px] font-bold text-white uppercase backdrop-blur-md bg-white/10 border border-white/20">
        {type}
      </div>
    )}

    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500 scale-90 group-hover:scale-100">
      <div class="w-12 h-12 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-white shadow-lg">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="white" stroke="currentColor" stroke-width="0" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 p-4 translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
      <h3 class="font-bold text-white text-sm md:text-base leading-tight line-clamp-2 mb-1 group-hover:text-[#a569bd] transition-colors duration-300">
        {title}
      </h3>
    </div>
  </div>
</a>
