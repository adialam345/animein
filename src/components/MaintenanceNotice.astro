---
import fs from 'node:fs/promises';
import path from 'node:path';

let maintenance = { isMaintenance: false, message: '', expectedReturn: '' };

try {
  const data = await fs.readFile(path.join(process.cwd(), 'public/data/maintenance.json'), 'utf-8');
  maintenance = JSON.parse(data);
} catch (e) {
  // Ignore
}

const { isMaintenance, message, expectedReturn } = maintenance;

const isAdminPage = Astro.url.pathname.startsWith('/admin');
const showMaintenance = isMaintenance && !isAdminPage;
---

{showMaintenance && (
  <div class="fixed inset-0 z-[200] flex items-center justify-center p-4 bg-zinc-950/90 backdrop-blur-md">
    <div class="max-w-md w-full bg-zinc-900 border border-white/5 rounded-3xl p-8 text-center shadow-2xl relative overflow-hidden group">
      <div class="absolute -top-24 -left-24 w-48 h-48 bg-purple-500/10 rounded-full blur-3xl group-hover:bg-purple-500/20 transition-all duration-700"></div>
      <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-purple-500/10 rounded-full blur-3xl group-hover:bg-purple-500/20 transition-all duration-700"></div>

      <div class="relative z-10">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-white/5 border border-white/10 mb-6 shadow-inner relative">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
          </svg>
          <div class="absolute -top-1 -right-1 flex h-4 w-4">
             <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
             <span class="relative inline-flex rounded-full h-4 w-4 bg-purple-500"></span>
          </div>
        </div>

        <h1 class="text-3xl font-black text-white mb-4 tracking-tight">
          Maintenance Mode
        </h1>
        
        <p class="text-zinc-400 leading-relaxed mb-8 font-light">
          {message}
        </p>

        <div class="bg-purple-500/5 rounded-2xl p-5 border border-purple-500/10 mb-8">
          <span class="text-[10px] font-bold uppercase tracking-widest text-zinc-500 block mb-1">Perkiraan Kembali</span>
          <span class="text-purple-400 font-bold">{expectedReturn}</span>
        </div>

        <div class="flex flex-col gap-3">
            <button onclick="window.location.reload()" class="w-full py-4 bg-white text-black rounded-2xl font-bold hover:bg-zinc-200 transition-all active:scale-95">
                Coba Segarkan
            </button>
        </div>
      </div>
    </div>
  </div>
)}

<script is:inline>
  window.showGlobalMaintenance = (message, expectedReturn) => {
    if (document.getElementById('maint-overlay')) return;
    document.body.style.overflow = 'hidden';

    const overlay = document.createElement('div');
    overlay.id = 'maint-overlay';
    overlay.className = 'fixed inset-0 z-[2147483647] flex items-center justify-center p-4 bg-zinc-950/90 backdrop-blur-md animate-fade-in';
    
    overlay.innerHTML = `
      <div class="max-w-md w-full bg-zinc-900 border border-white/5 rounded-3xl p-8 text-center shadow-2xl relative overflow-hidden mx-auto">
        <div class="absolute -top-24 -left-24 w-48 h-48 bg-purple-500/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-purple-500/10 rounded-full blur-3xl"></div>

        <div class="relative z-10">
          <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-white/5 border border-white/10 mb-6 shadow-inner relative">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
            </svg>
             <div class="absolute -top-1 -right-1 flex h-4 w-4">
               <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
               <span class="relative inline-flex rounded-full h-4 w-4 bg-purple-500"></span>
            </div>
          </div>

          <h1 class="text-3xl font-black text-white mb-4 tracking-tight">Maintenance Mode</h1>
          <p class="text-zinc-400 leading-relaxed mb-8 font-light">${message}</p>

          <div class="bg-purple-500/5 rounded-2xl p-5 border border-purple-500/10 mb-8">
            <span class="text-[10px] font-bold uppercase tracking-widest text-zinc-500 block mb-1">Perkiraan Kembali</span>
            <span class="text-purple-400 font-bold">${expectedReturn}</span>
          </div>

          <button onclick="window.location.reload()" class="w-full py-4 bg-white text-black rounded-2xl font-bold hover:bg-zinc-200 transition-all active:scale-95">
              Coba Segarkan
          </button>
        </div>
      </div>
    `;
    document.body.appendChild(overlay);
  };
</script>
