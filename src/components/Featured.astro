---
// Component logic moved to client-side to prevent 429 Rate Limits and use User IP
---

<section class="pt-4 pb-12 md:pt-6 md:pb-20 relative overflow-hidden" id="featured-section">
  {/* Background glow effects */}
  <div class="absolute -top-[10%] -left-[5%] w-[300px] h-[300px] bg-[#8e44ad]/5 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="absolute top-[40%] -right-[5%] w-[400px] h-[400px] bg-[#a569bd]/5 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="container mx-auto px-4 md:px-8 relative z-10 space-y-20" id="content-container">
    {/* Loading Skeleton */}
    <div id="loading-state" class="space-y-20">
      {[1, 2, 3].map(() => (
        <div class="animate-pulse">
          <div class="h-8 w-48 bg-zinc-800 rounded-lg mb-8"></div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-6">
            {[1, 2, 3, 4, 5, 6].map(() => (
              <div class="aspect-[3/4] bg-zinc-800 rounded-2xl"></div>
            ))}
          </div>
        </div>
      ))}
    </div>

    {/* Real content will be injected here */}
    <div id="real-content" class="hidden space-y-20"></div>

    {/* Error state */}
    <div id="error-state" class="hidden text-center py-20">
        <p class="text-zinc-500">Gagal memuat data. Periksa koneksi internet Anda.</p>
        <button onclick="window.location.reload()" class="mt-4 text-[#a569bd] font-bold">Coba Lagi</button>
    </div>
  </div>
</section>

<script>
  // Script ini berjalan di BROWSER Pengunjung (IP Pengunjung)
  async function fetchAnimeClient() {
    const loadingState = document.getElementById('loading-state');
    const realContent = document.getElementById('real-content');
    const errorState = document.getElementById('error-state');

    const BASE_URL = 'https://www.sankavollerei.com/anime/animasu';

    // Mendefinisikan fungsi fetch dengan retry sederhana
    async function smartFetch(url, delay = 0) {
      if (delay > 0) await new Promise(r => setTimeout(r, delay));
      
      const res = await fetch(url);
      if (res.status === 429) {
          console.warn('Rate limited, waiting 3s...');
          await new Promise(r => setTimeout(r, 3000));
          return smartFetch(url); 
      }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json();
    }

    try {
      console.log('[AnimeIn] Fetching directly via Browser IP...');
      
      // Hit API berurutan agar tidak memicu Rate Limit berlebihan
      const latestData = await smartFetch(`${BASE_URL}/latest?page=1`);
      const recommendedData = await smartFetch(`${BASE_URL}/popular?page=1`, 500); 
      const moviesData = await smartFetch(`${BASE_URL}/movies?page=1`, 500);

      // Pastikan data yang diambil adalah array
      const latest = latestData.animes || [];
      const recommended = recommendedData.animes || [];
      const movies = moviesData.animes || [];

      if (latest.length === 0 && recommended.length === 0 && movies.length === 0) {
          throw new Error('Semua kategori kosong. Kemungkinan API sedang maintenance.');
      }

      let html = '';
      const sections = [
        { title: 'Update Terbaru', subtitle: 'Jangan lewatkan episode terbaru anime favoritmu.', data: latest, type: 'Latest' },
        { title: 'Rekomendasi', subtitle: 'Pilihan terbaik untuk kamu tonton hari ini.', data: recommended, type: 'Popular' },
        { title: 'Anime Movies', subtitle: 'Koleksi film anime layar lebar terbaik.', data: movies, type: 'Movie' }
      ];

      sections.forEach(section => {
        if (!section.data || section.data.length === 0) return;
        
        html += `
          <div>
            <div class="flex items-end justify-between mb-8 md:mb-12">
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <div class="h-8 w-1.5 bg-[#8e44ad] rounded-full shadow-[0_0_15px_rgba(142,68,173,0.4)]"></div>
                  <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight">${section.title}</h2>
                </div>
                <p class="text-zinc-500 font-medium ml-3">${section.subtitle}</p>
              </div>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-6">
              ${section.data.map(item => `
                <a href="/anime/${item.slug}" class="group relative block aspect-[3/4] overflow-hidden rounded-2xl bg-zinc-900 border border-zinc-800/50 hover:border-[#8e44ad]/50 transition-all duration-500">
                  <img src="${item.poster}" alt="${item.title}" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent opacity-80 transition-opacity duration-500 group-hover:opacity-90"></div>
                  <div class="absolute bottom-0 left-0 right-0 p-4 transform transition-transform duration-500">
                    <div class="text-[10px] font-black uppercase tracking-widest text-[#a569bd] mb-1 opacity-0 group-hover:opacity-100 transition-opacity duration-500">${section.type}</div>
                    <h3 class="text-sm font-bold text-white line-clamp-2 leading-tight">${item.title}</h3>
                    <div class="text-[10px] text-zinc-400 mt-1">${item.episode || item.status_or_day || ''}</div>
                  </div>
                </a>
              `).join('')}
            </div>
          </div>
        `;
      });

      realContent.innerHTML = html;
      loadingState.classList.add('hidden');
      realContent.classList.remove('hidden');

    } catch (err) {
      console.error('Fetch Error:', err);
      loadingState.classList.add('hidden');
      errorState.classList.remove('hidden');
      errorState.querySelector('p').innerText = `Gagal memuat data: ${err.message}`;
    }
  }

  document.addEventListener('DOMContentLoaded', fetchAnimeClient);
  document.addEventListener('astro:after-swap', fetchAnimeClient);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    fetchAnimeClient();
  }
</script>

<style>
  .container {
    max-width: 1200px;
  }
</style>
