---
import AnimeCard from './AnimeCard.astro';
import { animeApi } from '../services/anime';

const latestAnime = await animeApi.getLatest();
const recommendedAnime = await animeApi.getRecommended();
const movieAnime = await animeApi.getMovies();

// Helper to normalize data for AnimeCard
const normalizeLatest = (anime: any) => ({
  id: anime.url,
  title: anime.judul,
  coverImage: anime.cover,
  rating: 'New',
  type: 'Latest',
  status: anime.lastch || 'Updated'
});

const normalizeRecommended = (anime: any) => ({
  id: anime.url,
  title: anime.judul,
  coverImage: anime.cover,
  rating: anime.score || 'N/A',
  type: anime.rilis || 'Series',
  status: anime.total_episode ? `${anime.total_episode} Eps` : 'Ongoing'
});

const normalizeMovie = (anime: any) => ({
  id: anime.url,
  title: anime.judul,
  coverImage: anime.cover,
  rating: 'Movie',
  type: 'Film',
  status: 'Finished'
});
---

<section class="pt-4 pb-12 md:pt-6 md:pb-20 relative overflow-hidden">
  {/* Background glow effects */}
  <div class="absolute -top-[10%] -left-[5%] w-[300px] h-[300px] bg-[#8e44ad]/5 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="absolute top-[40%] -right-[5%] w-[400px] h-[400px] bg-[#a569bd]/5 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="container mx-auto px-4 md:px-8 relative z-10 space-y-20">
    
    {/* Latest Section */}
    {latestAnime && latestAnime.length > 0 && (
      <div>
        <div class="flex items-end justify-between mb-8 md:mb-12">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <div class="h-8 w-1.5 bg-[#8e44ad] rounded-full shadow-[0_0_15px_rgba(142,68,173,0.4)]"></div>
              <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight">Update Terbaru</h2>
            </div>
            <p class="text-zinc-500 font-medium ml-3">Jangan lewatkan episode terbaru anime favoritmu.</p>
          </div>
          <a href="/trending" class="hidden md:flex items-center gap-2 text-sm font-bold text-[#a569bd] hover:text-white transition-all duration-300 group">
            Lihat Semua
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-6">
          {latestAnime.map(anime => (
            <AnimeCard {...normalizeLatest(anime)} />
          ))}
        </div>
      </div>
    )}

    {/* Recommended Section */}
    {recommendedAnime && recommendedAnime.length > 0 && (
      <div>
        <div class="flex items-end justify-between mb-8 md:mb-12">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <div class="h-8 w-1.5 bg-[#8e44ad] rounded-full shadow-[0_0_15px_rgba(142,68,173,0.4)]"></div>
              <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight">Rekomendasi</h2>
            </div>
            <p class="text-zinc-500 font-medium ml-3">Pilihan terbaik untuk kamu tonton hari ini.</p>
          </div>
          <a href="/trending" class="hidden md:flex items-center gap-2 text-sm font-bold text-[#a569bd] hover:text-white transition-all duration-300 group">
            Lihat Semua
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-6">
          {recommendedAnime.map(anime => (
            <AnimeCard {...normalizeRecommended(anime)} />
          ))}
        </div>
      </div>
    )}

    {/* Movies Section */}
    {movieAnime && movieAnime.length > 0 && (
      <div>
        <div class="flex items-end justify-between mb-8 md:mb-12">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <div class="h-8 w-1.5 bg-[#8e44ad] rounded-full shadow-[0_0_15px_rgba(142,68,173,0.4)]"></div>
              <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight">Anime Movies</h2>
            </div>
            <p class="text-zinc-500 font-medium ml-3">Koleksi film anime layar lebar terbaik.</p>
          </div>
          <a href="/movies" class="hidden md:flex items-center gap-2 text-sm font-bold text-[#a569bd] hover:text-white transition-all duration-300 group">
            Lihat Semua
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-6">
          {movieAnime.map(anime => (
            <AnimeCard {...normalizeMovie(anime)} />
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .container {
    max-width: 1200px;
  }
</style>
