---
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import SearchModal from '../components/SearchModal.astro';
import { ViewTransitions } from 'astro:transitions';
import AnalyticsTracker from '../components/AnalyticsTracker.astro';
import MaintenanceNotice from '../components/MaintenanceNotice.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "ANIMEIN | Your Ultimate Anime Portal",
	description = "Experience anime like never before. High-quality streams, latest updates, and an immersive community."
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/og-image.png" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content="/og-image.png" />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;700;800&display=swap" rel="stylesheet">

		<!-- PWA / Web App -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#8e44ad" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="ANIMEIN" />
		<link rel="apple-touch-icon" href="/icon-512.png" />
		<ViewTransitions />
	</head>
	<body>
		<div id="loading-bar" class="fixed top-0 left-0 h-1 bg-[#8e44ad] z-[9999] transition-all duration-300 w-0 opacity-0 pointer-events-none shadow-[0_0_10px_rgba(142,68,173,0.8)]"></div>
		<Header />
		<slot />
		<BottomNav />
		<SearchModal />
		<AnalyticsTracker />
		<MaintenanceNotice />

		<script>
			document.addEventListener('astro:before-preparation', () => {
				const bar = document.getElementById('loading-bar');
				if (bar) {
					bar.style.width = '30%';
					bar.style.opacity = '1';
				}
			});

			document.addEventListener('astro:before-send-dom', () => {
				const bar = document.getElementById('loading-bar');
				if (bar) {
					bar.style.width = '70%';
				}
			});

			document.addEventListener('astro:after-navigation', () => {
				const bar = document.getElementById('loading-bar');
				if (bar) {
					bar.style.width = '100%';
					setTimeout(() => {
						bar.style.opacity = '0';
						setTimeout(() => {
							if (bar) bar.style.width = '0%';
						}, 300);
					}, 200);
				}
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
		--font-heading: 'Outfit', sans-serif;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-heading);
		font-weight: 700;
		letter-spacing: -0.02em;
	}
</style>
